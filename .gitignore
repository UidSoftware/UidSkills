# UidSkills — .gitignore

# Sistema operacional
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db

# Editor
.vscode/
.idea/
*.swp
*.swo
*~

# Python (se houver scripts auxiliares)
__pycache__/
*.py[cod]
*.pyo
.env
.env.*
!.env.example
venv/
.venv/

# Node (se houver ferramentas JS)
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Outputs temporários
*.log
*.tmp
*.temp

# Arquivos gerados pelo pipeline
# (outputs ficam nos projetos, não no repo de skills)
output/
outputs/
/tmp/

# Credenciais — NUNCA commitar
*.pem
*.key
secrets/
credentials/
